# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Secrets (GENERATE NEW ONES FOR PRODUCTION!)
APP_KEYS=REPLACE_WITH_SECURE_KEYS
API_TOKEN_SALT=REPLACE_WITH_SECURE_SALT
ADMIN_JWT_SECRET=REPLACE_WITH_SECURE_SECRET
TRANSFER_TOKEN_SALT=REPLACE_WITH_SECURE_SALT
ENCRYPTION_KEY=REPLACE_WITH_SECURE_KEY
JWT_SECRET=REPLACE_WITH_SECURE_SECRET

# Database - Supabase PostgreSQL
# ⚠️ CRITICAL: Use POOLER URL, not direct connection!
# Go to Supabase > Project Settings > Database > Connection Pooling
# Copy the "Transaction" mode connection string (port 6543)
#
# WRONG (direct): postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
# RIGHT (pooler): postgres://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://postgres.xxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# CORS Origins (comma-separated production domains)
CORS_ORIGINS=https://magnus.vercel.app,https://www.yourdomain.com

# Preview Configuration
CLIENT_URL=https://magnus.vercel.app
PREVIEW_SECRET=REPLACE_WITH_SECURE_SECRET

# AI Configuration
AI_PROVIDER=gemini
GOOGLE_AI_API_KEY=your-google-ai-key

# Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-credentials.json
TTS_WEBHOOK_SECRET=REPLACE_WITH_SECURE_SECRET
STRAPI_INTERNAL_URL=https://your-strapi.railway.app

# Redis (Security Rate Limiting)
REDIS_URL=your-upstash-redis-url

# Cloudflare R2 (Media Storage)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=magnus-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com

# Observability
SENTRY_DSN=your-sentry-dsn
