{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Core MAGNUS content object"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 130,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 380
    },
    "article_date": {
      "type": "date",
      "required": false
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "hero_image_caption": {
      "type": "string",
      "maxLength": 255
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "articles"
    },
    "content_blocks": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.quote",
        "content.gallery",
        "content.embed",
        "content.audio",
        "content.single-image",
        "content.illustrations",
        "content.infographics"
      ]
    },
    "video_summary": {
      "type": "component",
      "component": "ai.video-summary",
      "repeatable": false
    },
    "audio_summary": {
      "type": "component",
      "component": "ai.audio-summary",
      "repeatable": false
    },
    "ppt_summary": {
      "type": "component",
      "component": "ai.ppt-summary",
      "repeatable": false
    },
    "infographic_summary": {
      "type": "component",
      "component": "ai.infographic-summary",
      "repeatable": false
    },
    "related_articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    },
    "state": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "review",
        "published",
        "scheduled",
        "archived"
      ]
    },
    "reading_time": {
      "type": "integer"
    },
    "isSpecial": {
      "type": "boolean",
      "default": false
    },
    "ai_metadata": {
      "type": "json",
      "private": true
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "article"
    },
    "tts_audio": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "tts_metadata": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "tts_hash": {
      "type": "string"
    },
    "tts_status": {
      "type": "enumeration",
      "enum": [
        "none",
        "pending",
        "ready",
        "error"
      ],
      "default": "none"
    },
    "tts_last_error": {
      "type": "text"
    },
    "search_keywords": {
      "type": "text",
      "private": true
    }
  }
}