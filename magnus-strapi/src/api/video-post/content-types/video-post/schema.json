{
    "kind": "collectionType",
    "collectionName": "video_posts",
    "info": {
        "singularName": "video-post",
        "pluralName": "video-posts",
        "displayName": "Video Post",
        "description": "Video content for the Videos del Día feed"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "maxLength": 150,
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "dek": {
            "type": "text",
            "maxLength": 300
        },
        "video": {
            "type": "media",
            "multiple": false,
            "required": true,
            "allowedTypes": [
                "videos"
            ]
        },
        "poster": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "priority": {
            "type": "integer",
            "default": 0
        },
        "duration_seconds": {
            "type": "integer"
        },
        "video_date": {
            "type": "date",
            "required": true
        },
        "like_count": {
            "type": "integer",
            "default": 0
        },
        "related_article": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::article.article"
        }
    }
}