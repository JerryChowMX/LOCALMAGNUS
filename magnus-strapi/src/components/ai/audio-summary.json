{
    "collectionName": "components_ai_audio_summaries",
    "info": {
        "displayName": "Podcast Summary",
        "icon": "headphones",
        "description": "AI-generated podcast audio version"
    },
    "options": {},
    "attributes": {
        "episode_label": {
            "type": "string",
            "default": "EPISODIO",
            "description": "Label shown above podcast title (e.g., EPISODIO 1, RESUMEN, ESCUCHA)"
        },
        "podcast_title": {
            "type": "string",
            "description": "Custom title for the podcast (if different from article title)"
        },
        "audio_file": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "audios"
            ]
        },
        "voice": {
            "type": "enumeration",
            "enum": [
                "male",
                "female",
                "neural"
            ],
            "default": "neural"
        },
        "generated_at": {
            "type": "datetime"
        },
        "file_size": {
            "type": "integer",
            "description": "Size in bytes"
        }
    }
}